&GLOBAL
  PROJECT water
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &SUBSYS
    &COORD
      O   0.000000   0.000000   0.117300
      H   0.000000   0.757200  -0.469200
      H   0.000000  -0.757200  -0.469200
    &END COORD
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &KIND O
      BASIS_SET DZVP
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
      BASIS_SET DZVP
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
    &END SCF
  &END DFT
&END FORCE_EVAL
